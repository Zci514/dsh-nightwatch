{
  "name": "dsh-nightwatch",
  "version": "1.2.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "守夜：给 DeepSeek Harness 的输入框加一颗按钮，选个钟点，会话一直续跑到那时自动停",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nightwatch",
    "automation",
    "scheduler"
  ],
  "homepage": "https://github.com/Zci514/dsh-nightwatch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zci514/dsh-nightwatch.git"
  },
  "bugs": {
    "url": "https://github.com/Zci514/dsh-nightwatch/issues"
  },
  "author": "Zci514",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
